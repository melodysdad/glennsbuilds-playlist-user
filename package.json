{
  "name": "glennsbuilds-playlist-user",
  "version": "1.0.0",
  "description": "User management and playlist service for glennsbuilds playlist application",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && cp package.json build/ && tsx scripts/generate-openapi.ts",
    "build:watch": "tsc --watch",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run tests/lambda tests/storage tests/integration tests/tools",
    "test:watch": "vitest tests/lambda tests/storage tests/integration tests/tools",
    "test:coverage": "vitest run --coverage tests/lambda tests/storage tests/integration tests/tools",
    "test:unit": "vitest run tests/lambda tests/storage",
    "test:integration": "vitest run tests/integration",
    "test:lambda": "vitest run tests/lambda",
    "test:all": "npm run type-check && npm run lint && npm run test:coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "dev": "npm run build:watch",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all",
    "cdk:deploy:dev": "cdk deploy --all --context stage=dev",
    "cdk:deploy:prod": "cdk deploy --all --context stage=prod",
    "cdk:destroy": "cdk destroy --all",
    "cdk:diff": "cdk diff",
    "cdk:bootstrap": "cdk bootstrap"
  },
  "keywords": [
    "playlist",
    "user",
    "lambda",
    "aws",
    "cdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.3.2",
    "@aws-lambda-powertools/parser": "^2.30.0",
    "@aws-sdk/client-dynamodb": "^3.958.0",
    "@aws-sdk/client-lambda": "^3.709.0",
    "@aws-sdk/client-servicediscovery": "^3.709.0",
    "@aws-sdk/util-dynamodb": "^3.958.0",
    "aws-lambda": "^1.0.7",
    "js-yaml": "^4.1.1",
    "source-map-support": "^0.5.21",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.709.0",
    "@eslint/js": "^9.17.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^4.0.16",
    "aws-cdk": "^2.172.0",
    "aws-cdk-lib": "^2.172.0",
    "constructs": "^10.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.0.16"
  }
}
